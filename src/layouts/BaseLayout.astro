---
import '@fontsource/anton/400.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/900.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import '../styles/global.css';
import { generateSEOTags, generateJSONLD, defaultSEO, type SEOMetadata } from '../lib/seo';
import aboutData from '../content/about.json';

interface Props {
  seo?: Partial<SEOMetadata>;
}

const { seo = {} } = Astro.props;
const seoData = { ...defaultSEO, ...seo };
const seoTags = generateSEOTags(seoData);

// Environment variables
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://alexrivera.dev';

// JSON-LD Schema
const personSchema = generateJSONLD('Person', {
  name: aboutData.name,
  role: aboutData.role,
  bio: aboutData.bio,
  url: siteUrl,
  avatar: aboutData.avatar,
  linkedin: aboutData.links.linkedin,
  github: aboutData.links.github,
});

const websiteSchema = generateJSONLD('WebSite', {
  name: `${aboutData.name} - Portfolio`,
  description: seoData.description,
  url: siteUrl,
  author: aboutData.name,
});
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F0560A" />

    <!-- Anton renders the hero name: preload so it shows without delay -->
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    
    <!-- SEO Meta Tags -->
    <title>{seoTags.title}</title>
    <meta name="description" content={seoTags.description} />
    <meta name="author" content={seoTags.openGraph.siteName} />
    <link rel="canonical" href={siteUrl} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={seoTags.openGraph.type} />
    <meta property="og:title" content={seoTags.openGraph.title} />
    <meta property="og:description" content={seoTags.openGraph.description} />
    <meta property="og:image" content={seoTags.openGraph.image} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={seoTags.openGraph.siteName} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content={seoTags.twitter.card} />
    <meta name="twitter:title" content={seoTags.twitter.title} />
    <meta name="twitter:description" content={seoTags.twitter.description} />
    <meta name="twitter:image" content={seoTags.twitter.image} />
    <meta name="twitter:creator" content={seoTags.twitter.creator} />
    
    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={personSchema} />
    <script type="application/ld+json" set:html={websiteSchema} />
    
    <!-- Analytics Scripts -->
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
    
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  
  <body>
    <a
      href="#main-content"
      class="label sr-only z-[100] rounded-full bg-ink px-5 py-3 text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Saltar al contenido principal
    </a>
    <slot />

    <script is:inline>
      // Scroll-in reveal for static [data-reveal] elements (fade + rise, once).
      // Content is only hidden once this script runs (html.reveal-ready), so a
      // script failure never leaves the page invisible. React islands use
      // data-reveal="island" and the useReveal hook instead.
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) return;

        document.documentElement.classList.add('reveal-ready');
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        document
          .querySelectorAll('[data-reveal]:not([data-reveal="island"])')
          .forEach(function (el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
