---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home, ArrowLeft } from 'lucide-react';

const seo = {
  title: '404 - Página no encontrada | Erwing Solorzano',
  description: 'La página que buscas no existe. Vuelve al inicio para explorar el portafolio.',
};
---

<BaseLayout seo={seo}>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-mandarin px-5 md:px-10">
    <div class="text-center">
      <h1 class="m-0 font-display text-[clamp(120px,30vw,300px)] font-normal leading-[0.8] text-crest">404</h1>
      <h2 class="mb-4 mt-6 font-display text-[clamp(32px,5vw,64px)] font-normal uppercase leading-[0.9] text-forest">
        Página no encontrada
      </h2>
      <p class="mx-auto mb-8 max-w-md text-[17px] leading-normal text-ink">
        La página que buscas no existe o fue movida. Puedes volver al inicio para seguir explorando.
      </p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="label inline-flex min-h-11 items-center gap-2 rounded-full bg-forest px-6 text-cream transition-colors hover:bg-ink">
          <Home class="h-4 w-4" />
          Ir al inicio
        </a>
        <button
          type="button"
          onclick="history.back()"
          class="label inline-flex min-h-11 items-center gap-2 rounded-full bg-ink px-6 text-cream transition-colors hover:bg-forest"
        >
          <ArrowLeft class="h-4 w-4" />
          Volver atrás
        </button>
      </div>
    </div>
  </main>
</BaseLayout>
